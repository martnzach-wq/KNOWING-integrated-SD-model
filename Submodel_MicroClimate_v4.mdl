:GRAPH Temp_Output_Compare
:TITLE Temp Output Compare
:SCALE
:VAR CL ChangeCalc[temperature outputs,land cover class]
:DATASET 
:LINE-WIDTH 1
:VAR CL ChangeData[temperature outputs,land cover class]
:DATASET 
:LINE-WIDTH 1

:GRAPH TempShift_discont_dense
:TITLE Temp shift (°C) by urban features
:X-AXIS SimYear
:X-DIV 3
:X-MIN 2020
:X-MAX 2050
:NO-LEGEND 6
:FONT Arial|16||0-0-0
:SCALE
:VAR CL TempShiftByUrbanFeature[tmin,urban features,Discontinuous dense urban fabric]
:DATASET *
:LINE-WIDTH 3

:GRAPH TempShift_ind_commercial
:TITLE Temp shift (°C) by urban features
:X-AXIS SimYear
:X-DIV 3
:X-MIN 2020
:X-MAX 2050
:NO-LEGEND 6
:FONT Arial|16||0-0-0
:SCALE
:VAR CL TempShiftByUrbanFeature[tmax,urban features,Industrial commercial public military and private units]
:DATASET *
:LINE-WIDTH 3

:GRAPH Max_Day_temp_at_public_places
:TITLE Max_Day_temp_at_public_places
:X-AXIS SimYear
:Y-DIV 6
:X-MIN 2020
:X-MAX 2050
:SCALE
:VAR CL TempOutputCalc[tmax,Industrial commercial public military and private units]|optimised
