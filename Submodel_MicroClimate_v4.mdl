{UTF-8}
CL TempShiftByUrbanFeature[temperature outputs,urban features,land cover class]=
	CL Lambda UF[temperature outputs,urban features]*LU UrbanFeature[urban features,land cover class\
		]
	~	
	~		|

SimYear=
	2009 + Time / 12
	~	
	~		|

CL TempChangeContribution[temperature outputs,urban features]=
	SUM(CL Lambda UF[temperature outputs,urban features]*LU UrbanFeature[urban features,\
		land cover class!]*LU Percentage of city area[land cover class!]) /
	SUM(LU Percentage of city area[land cover class!])
	~	
	~		|

LU Sealed area stock[land cover class]= INTEG (
	-PI LU Unseal[land cover class],
		LU Sealed area percentage[land cover class])
	~	
	~		|

LU Unsealed area stock[land cover class]= INTEG (
	PI LU Unseal[land cover class],
		100 - LU Sealed area stock[land cover class])
	~	
	~		|

LU MatureTreeCO2PerYear=
	0.02
	~	t / year
	~	20kg
	|

LU Sealed area percentage of prev timestep[land cover class]=
	DELAY FIXED(LU Sealed area percentage[land cover class], TIME STEP , LU Sealed area percentage\
		[land cover class] )
	~	
	~		|

LU NetCO2capturedByTrees=
	SUM( LU YoungTreesStock[land cover class!]*LU YoungTreeCO2PerYear + LU MatureTreesStock\
		[land cover class!]*LU MatureTreeCO2PerYear)
	~	
	~		|

PI LU Unseal[land cover class]=
	(LU Sealed area percentage of prev timestep[land cover class] - LU Sealed area percentage\
		[land cover class]) * 0
	~	
	~		|

PH Hospitalisation rate=
	CL Heatwave Duration*CL Heatwave Frequency*CL PeakSummerTemp
	~	
	~	Dummy calculation that only depends on climate impacts, not on policy \
		interventions
	|

CL CalibrationWeight[temperature outputs, land cover class]=
	LU Percentage of city area[land cover class]
	~	
	~		|

LU Mature Trees[land cover class]:LOOK FORWARD:
	~	
	~		|

LU MatureTreesStock[land cover class]= INTEG (
	LU TreesMature[land cover class],
		GET DATA AT TIME(LU Mature Trees[land cover class], 120))
	~	
	~		|

CL ChangeCalc[temperature outputs,land cover class]=
	CL TempOutputCalc[temperature outputs,land cover class] - CL PeakSummerTemp - CL TempShift\
		[temperature outputs]
	~	
	~		|

CL ChangeData[temperature outputs,land cover class]=
	CL TempOutput[temperature outputs,land cover class] - CL PeakSummerTemp - CL TempShift\
		[temperature outputs]
	~	
	~		|

LU Percentage of city area[land cover class]:INTERPOLATE:
	~	
	~		|

LU TreesMature[land cover class]=
	DELAY FIXED(PI LU PlantTrees[land cover class], 120 , PI LU PlantTrees[land cover class\
		] )
	~	
	~		|

CL TempOutput[temperature outputs,land cover class]:RAW:
	~	
	~		|

LU YoungTreesStock[land cover class]= INTEG (
	PI LU PlantTrees[land cover class]-LU TreesMature[land cover class],
		GET DATA AT TIME(LU Young Trees[land cover class], 120))
	~	
	~		|

LU UrbanFeature[Sealed area percentage,land cover class]=
	LU Sealed area percentage[land cover class] ~~|
LU UrbanFeature[Buildings height,land cover class]=
	LU Buildings area percentage[land cover class] * LU Buildings height[land cover class\
		] / 10 ~~|
LU UrbanFeature[Young Trees,land cover class]=
	LU YoungTreesStock[land cover class] / LU Percentage of city area[land cover class] ~~|
LU UrbanFeature[Mature Trees,land cover class]=
	LU MatureTreesStock[land cover class] / LU Percentage of city area[land cover class]\
		 / 100
	~	
	~		|

LU Sealed area percentage[land cover class]:INTERPOLATE:
	~	
	~		|

LU Young Trees[land cover class]:LOOK FORWARD:
	~	
	~		|

LU Buildings height[land cover class]:INTERPOLATE:
	~	
	~		|

LU Buildings area percentage[land cover class]:INTERPOLATE:
	~	
	~		|

PI LU PlantTrees[land cover class]=
	LU Young Trees[land cover class] / 120 * 0
	~	
	~		|

CL TempOutputCalc[temperature outputs,land cover class]=
	CL PeakSummerTemp + CL TempShift[temperature outputs] + SUM(CL Lambda UF[temperature outputs\
		,urban features!]*LU UrbanFeature[urban features!,land cover class])
	~	
	~		|

CL TMax Compare[temperature outputs,land cover class]=
	CL TempOutputCalc[temperature outputs,land cover class] - CL TempOutput[temperature outputs\
		,land cover class]
	~	
	~		|

temperature outputs:
	tmax, tmin
	~	
	~		|

urban features:
	Sealed area percentage,
	Buildings height,
	Young Trees,
	Mature Trees
	~	
	~		|

land cover class:
	continuous urban fabric,
	Discontinuous dense urban fabric,
	Discontinuous medium density urban fabric,
	Discontinuous low density urban fabric,
	Discontinuous very low density urban fabric,
	Industrial commercial public military and private units,
	Railways and associated land,
	Airports,
	Mineral extraction and dump sites,
	Construction sites,
	Land without current use,
	green urban areas,
	Sports and leisure facilities,
	Forests,
	Herbaceous vegetation associations,
	Open spaces with little or no vegetation,
	Remaining class added,
	Pastures and arable land,
	Port areas and other roads with associated land
	~	
	~		|

CL Lambda UF[temperature outputs,urban features]=
	0
	~	
	~		|

CL TempShift[temperature outputs]=
	1
	~	
	~		|

PI StreetGreening=
	0
	~	 [0,1,0.1]
	~		|

LU StreetGreening=
	LU Streets * 0.02 / 12 * PI StreetGreening
	~	
	~	convert max. 2% per year (PI_Attr = 1)
	|

LU InitialBuildings=
	1-LU InitialForestArea-LU InitialGreenArea-LU InitialStreets-LU InitialUnsealedParkingSpace\
		-LU InitialWaterArea
	~	
	~		|

CL UTCI Threshold=
	38
	~	
	~		|

CL Hotspot Area=
	IF THEN ELSE(CL PeakSummerTemp > CL UTCI Threshold-5, (CL PeakSummerTemp-CL UTCI Threshold\
		+5)/10*LU Streets*(1-0.5*LU TreeDensityStreets) , 0) +
	0*LU Buildings+
	0*LU ForestArea+
	0*LU GreenArea+
	0*LU Unsealed Parking Spaces+
	0*LU WaterArea
	~	
	~		|

LU YoungTreeCO2PerYear=
	0.01
	~	t / year
	~	10kg
	|

CL AverageSummerTemperature=
	CL MeteorologicalAverageTemperature + 8
	~	
	~		|

CL Cooling degree days=
	(CL PeakSummerTemp - HO CoolingThreshold) * CL Heatwave Duration * CL Heatwave Frequency
	~	
	~		|

CL Heatwave Duration=
	7 + (CL AverageSummerTemperature - 16)
	~	
	~		|

CL Heatwave Frequency=
	3 + (CL AverageSummerTemperature - 16)
	~	
	~		|

CL MeteorologicalAverageTemperature=
	10 + 0*1 / 10 * Time /12
	~	
	~		|

CL PeakSummerTemp=
	CL AverageSummerTemperature + 12 + 1.6 * Time / 492
	~	
	~		|

LU UnsealParkingSpaces=
	0
	~	
	~		|

HO CoolingThreshold=
	24
	~	
	~		|

LU Unsealed Parking Spaces= INTEG (
	LU UnsealParkingSpaces,
		LU InitialUnsealedParkingSpace)
	~	
	~		|

LU Streets= INTEG (
	LU NewStreets-LU StreetGreening-LU UnsealParkingSpaces,
		LU InitialStreets)
	~	
	~		|

LU InitialUnsealedParkingSpace=
	0
	~	
	~		|

LU Afforestation=
	0
	~	
	~		|

LU Buildings= INTEG (
	LU NewBuildings,
		LU InitialBuildings)
	~	
	~		|

LU ForestArea= INTEG (
	LU Afforestation,
		LU InitialForestArea)
	~	
	~		|

LU GreenArea= INTEG (
	LU StreetGreening-LU Afforestation-LU GreenToWater-LU NewBuildings-LU NewStreets,
		LU InitialGreenArea)
	~	
	~		|

LU GreenToWater=
	0
	~	
	~		|

LU InitialForestArea=
	0.1
	~	
	~		|

LU InitialGreenArea=
	0.24
	~	
	~		|

LU InitialStreets=
	0.2
	~	
	~		|

LU InitialWaterArea=
	0.1
	~	
	~		|

LU NewBuildings=
	0
	~	
	~		|

LU NewStreets=
	0
	~	
	~		|

LU TreeDensityForest=
	1
	~	
	~		|

LU TreeDensityStreets=
	0
	~	
	~		|

LU WaterArea= INTEG (
	LU GreenToWater,
		LU InitialWaterArea)
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 492
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

